\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces A laundering ring detected by RTXGNN on the synthetic benchmark (graph 0, default setting). Red: ring members with their predicted probability; blue: up to three ordinary counterparties per member; outlined: a test account. Red solid arrows are the ring transactions (labelled with the transaction day and the relative importance), grey dashed arrows ordinary transactions into ring members. Arrow width is the relative SEAL importance of a transaction, i.e.\ its share of the total importance $\DOTSB \sum@ \slimits@ _u I_{uv}$ of all transactions received by the member $v$ (Eq.~\ref {eq:explanation}).}}{34}{figure.5}\protected@file@percent }
\newlabel{fig:ring}{{5}{34}{A laundering ring detected by RTXGNN on the synthetic benchmark (graph 0, default setting). Red: ring members with their predicted probability; blue: up to three ordinary counterparties per member; outlined: a test account. Red solid arrows are the ring transactions (labelled with the transaction day and the relative importance), grey dashed arrows ordinary transactions into ring members. Arrow width is the relative SEAL importance of a transaction, i.e.\ its share of the total importance $\sum _u I_{uv}$ of all transactions received by the member $v$ (Eq.~\ref {eq:explanation})}{figure.5}{}}
